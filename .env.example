# Copy to .env and change the token and secret before any shared use.
# All variables use the OIA_ prefix. Fixture mode is the default so the
# application can start and demonstrate analysis without a live database.
# Set OIA_FIXTURE_MODE=false only when read-only Test and Production
# credentials are available. LLM egress stays off until an approved
# endpoint is explicitly enabled.

OIA_APP_ENV=development
OIA_SECRET_KEY=replace-with-a-long-random-string
OIA_APP_ACCESS_TOKEN=replace-with-a-local-access-token
OIA_HOST=127.0.0.1
OIA_PORT=8000
OIA_RUNS_DIR=runs
OIA_COOKIE_SECURE=false
OIA_FIXTURE_MODE=true

OIA_TEST_ORACLE_LABEL=TEST
OIA_TEST_ORACLE_DSN=
OIA_TEST_ORACLE_USER=
OIA_TEST_ORACLE_PASSWORD=

OIA_PROD_ORACLE_LABEL=PRODUCTION
OIA_PROD_ORACLE_DSN=
OIA_PROD_ORACLE_USER=
OIA_PROD_ORACLE_PASSWORD=

# Optional staging environment. Leave the DSN empty to skip it with a live
# database. In fixture mode a bundled AUTUMN catalog is used unless
# OIA_FIXTURE_AUTUMN=false.
OIA_AUTUMN_ORACLE_LABEL=AUTUMN
OIA_AUTUMN_ORACLE_DSN=
OIA_AUTUMN_ORACLE_USER=
OIA_AUTUMN_ORACLE_PASSWORD=
OIA_FIXTURE_AUTUMN=true

# Approvals, trusted baselines, change manifest, and business mappings need
# a second token that differs from OIA_APP_ACCESS_TOKEN. Empty disables them.
# Like the app token, this is a development sign-in, not enterprise SSO.
OIA_APPROVER_ACCESS_TOKEN=
# Registry of baselines, manifest, mappings, and object versions.
# Defaults to <OIA_RUNS_DIR>/_registry.
OIA_STATE_DIR=
# Optional JSON file that disables rules or changes how they resolve.
OIA_POLICY_FILE=
OIA_BASELINE_MAX_AGE_DAYS=30
OIA_SNAPSHOT_STALE_HOURS=24
# SQL performance is not evaluated: EXPLAIN PLAN writes PLAN_TABLE.
OIA_PERFORMANCE_PLAN_SOURCE=none

OIA_LLM_EGRESS_ENABLED=false
OIA_LLM_BASE_URL=
OIA_LLM_API_KEY=
OIA_LLM_MODEL=
OIA_MAX_TOOL_CALLS_PER_PACKAGE=15
OIA_MAX_TOOL_CALLS_PER_RUN=40
OIA_MAX_DEPENDENCY_DEPTH=2
OIA_ANALYSIS_TIMEOUT_SECONDS=120
OIA_LLM_TOKEN_BUDGET=8000
