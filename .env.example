# Copy to .env and change the token and secret before any shared use.
# All variables use the OIA_ prefix. Fixture mode is the default so the
# application can start and demonstrate analysis without a live database.
# Set OIA_FIXTURE_MODE=false only when read-only Test and Production
# credentials are available. LLM egress stays off until an approved
# endpoint is explicitly enabled.

OIA_APP_ENV=development
OIA_SECRET_KEY=replace-with-a-long-random-string
OIA_APP_ACCESS_TOKEN=replace-with-a-local-access-token
OIA_HOST=127.0.0.1
OIA_PORT=8000
OIA_RUNS_DIR=runs
OIA_COOKIE_SECURE=false
OIA_FIXTURE_MODE=true

# Display labels for the database each side points at. Findings always name the
# role (Test, Production) and add the label only when the two labels differ.
OIA_TEST_ORACLE_LABEL=TEST
OIA_TEST_ORACLE_DSN=
OIA_TEST_ORACLE_USER=
OIA_TEST_ORACLE_PASSWORD=
# Oracle editions. On one database the demo schema puts Test in OIA_TEST and
# Production in ORA$BASE. Leave both empty when Test and Production are
# separate databases. Quote ORA$BASE, or a shell that sources this file would
# expand $BASE to nothing.
OIA_TEST_ORACLE_EDITION=

OIA_PROD_ORACLE_LABEL=PRODUCTION
OIA_PROD_ORACLE_DSN=
OIA_PROD_ORACLE_USER=
OIA_PROD_ORACLE_PASSWORD=
OIA_PROD_ORACLE_EDITION=

# Recording the deployment decision needs a second token
# that differs from OIA_APP_ACCESS_TOKEN. Empty disables it.
# Like the app token, this is a development sign-in, not enterprise SSO.
OIA_APPROVER_ACCESS_TOKEN=
# Object version history across runs.
# Defaults to <OIA_RUNS_DIR>/_registry.
OIA_STATE_DIR=
# Optional JSON file that disables rules or changes how they resolve.
OIA_POLICY_FILE=
OIA_SNAPSHOT_STALE_HOURS=24
# SQL performance is not evaluated: EXPLAIN PLAN writes PLAN_TABLE.
OIA_PERFORMANCE_PLAN_SOURCE=none

OIA_LLM_EGRESS_ENABLED=false
OIA_LLM_BASE_URL=
OIA_LLM_API_KEY=
OIA_LLM_MODEL=
OIA_MAX_TOOL_CALLS_PER_PACKAGE=15
OIA_MAX_TOOL_CALLS_PER_RUN=40
OIA_MAX_DEPENDENCY_DEPTH=2
OIA_ANALYSIS_TIMEOUT_SECONDS=120
OIA_LLM_TOKEN_BUDGET=8000
# Agentic analysis reads every environment through the model, so it has its own run budget.
OIA_AGENTIC_TOKEN_BUDGET=60000
OIA_AGENTIC_MAX_TOOL_CALLS_PER_RUN=80
# Hybrid analysis asks the AI about dynamic SQL and synonyms the checks could not resolve. Answers are unverified leads.
OIA_BLIND_SPOT_MAX_QUESTIONS=6
OIA_BLIND_SPOT_MAX_TOOL_CALLS=12

# "Prepare email" drafts on each report. Nothing is sent by the application.
# Comma-separated recipient lists for the developer and support versions.
OIA_EMAIL_DEVELOPERS=
OIA_EMAIL_SUPPORT=
# Address colleagues use to open reports, for example https://impact.example.com
OIA_PUBLIC_BASE_URL=
