# Copy to .env and change the token and secret before any shared use.
# All variables use the OIA_ prefix. Fixture mode is the default so the
# application can start and demonstrate analysis without a live database.
# Set OIA_FIXTURE_MODE=false only when read-only Test and Production
# credentials are available. LLM egress stays off until an approved
# endpoint is explicitly enabled.

OIA_APP_ENV=development
OIA_SECRET_KEY=replace-with-a-long-random-string
OIA_APP_ACCESS_TOKEN=replace-with-a-local-access-token
OIA_HOST=127.0.0.1
OIA_PORT=8000
OIA_RUNS_DIR=runs
OIA_COOKIE_SECURE=false
OIA_FIXTURE_MODE=true

OIA_TEST_ORACLE_LABEL=TEST
OIA_TEST_ORACLE_DSN=
OIA_TEST_ORACLE_USER=
OIA_TEST_ORACLE_PASSWORD=

OIA_PROD_ORACLE_LABEL=PRODUCTION
OIA_PROD_ORACLE_DSN=
OIA_PROD_ORACLE_USER=
OIA_PROD_ORACLE_PASSWORD=

OIA_LLM_EGRESS_ENABLED=false
OIA_LLM_BASE_URL=
OIA_LLM_API_KEY=
OIA_LLM_MODEL=
OIA_MAX_TOOL_CALLS_PER_PACKAGE=15
OIA_MAX_TOOL_CALLS_PER_RUN=40
OIA_MAX_DEPENDENCY_DEPTH=2
OIA_ANALYSIS_TIMEOUT_SECONDS=120
OIA_LLM_TOKEN_BUDGET=8000
